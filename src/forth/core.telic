\ aliases
: true 1 ; inline
: false 0 ; inline
: print . ; inline
: print-stack .s ; inline

( name -- ) \ load lib/<name> from beside the telic binary; ".telic" added if absent
: load-library
	dup "\.telic$" has? not if ".telic" + then
	binary-dir "/lib/" + swap + load ;

\ type predicates, one per type-of symbol; a bound logic var reports as its value
: float? type-of :float = ; inline
: string? type-of :string = ; inline
: symbol? type-of :symbol = ; inline
: array? type-of :array = ; inline
: set? type-of :set = ; inline
: frame? type-of :frame = ; inline
: matrix? type-of :matrix = ; inline
: quantity? type-of :quantity = ; inline
: exact? type-of :exact = ; inline
: complex? type-of :complex = ; inline
: xt? type-of :xt = ; inline
: continuation? type-of :continuation = ; inline
: stream? type-of :stream = ; inline
: db? type-of :db = ; inline
: ptr? type-of :ptr = ; inline
: segment? type-of :segment = ; inline
: wildcard? type-of :wildcard = ; inline
: lvar? type-of :lvar = ; inline

( a b -- a b a b )
: 2dup over over ;
inline

( a b c -- c a b )
: -rot rot rot ;
inline

( a b -- b a b )
: tuck swap over ;
inline

( a b -- )
: 2drop drop drop ;
inline

( val -- val ) \ prints the top without consuming it
: peek dup . ;
inline

( val -- bool ) \ is tos 1?
: 1= 1 = ; inline

( a -- bool ) \ truthy: 1 when the value is truthy, the positive twin of 0=
: true? 0= 0= ; inline

( a -- bool ) \ falsy: 1 when the value is falsy — 0= under a predicate name
: false? 0= ; inline

( v low high -- bool ) \ low <= v <= high; element-wise mask on a matrix or
\ array operand, so * is the conjunction, not and (which tests whole values)
: between? 2 pick >= -rot >= * ; inline

( x low high -- x' ) \ x limited to [low, high]: a float, quantity, or matrix
\ (element-wise, scalar bounds broadcast); an array clamps each element
: clamp
	| operand lower-bound upper-bound |
	operand array? if operand [: lower-bound upper-bound clamp :] map exit then
	operand lower-bound max2 upper-bound min2 ;

: , peek ; inline

( arr/matrix -- v ) \ element 0: an array's first element, a matrix's
\ first row-major element
: first
	dup matrix? if 0 @e exit then
	0 @i ;

( arr/matrix -- v ) \ the final element: an array's, or a matrix's last row-major element
: last
	dup matrix? if dup dim * 1- @e exit then
	dup size 1- @i ;

( fr old new -- fr ) \ move the value at key old to key new in place; old absent
\ errors, an existing new is overwritten
: rename-key!
	| target-frame old-key new-key |
	target-frame target-frame old-key @ new-key ! old-key delete-at ;

( arr -- v ) \ element 1
: second 1 @i ; inline

( entries key -- value ) \ the value paired with key, the first match by
\ structural equality: entries are [ key value ] arrays (first is the key,
\ second the value); null when the key is absent
: assoc
	| entries key |
	entries [: first key = :] find-first
	dup null? not if second then ;

\ arithmetic words

( a b -- quotient ) \ integer quotient toward zero ( = % swap drop )
: quotient % swap drop ;
inline

( xt -- ... ) \ run xt, print elapsed CLOCK_MONOTONIC seconds, pass its results through
: timed now >r execute now r> - . cr ;

( val -- val ) \ The identity function
: identity ; inline

( -- arr ) \ one { :name :value :type } frame per global, oldest first
: variables
	(globals)
	[: binding |
	   binding 1 @i to value
	   { :name binding 0 @i :value value :type value type-of } 
	:] map ;
