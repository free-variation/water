\ LAPACK acceleration layer. Everything LAPACK-free lives in the embedded
\ src/forth/statistics.telic; this loadable library holds what needs the shared
\ library, and may mask an embedded word by redefining it in toto.

\ ---- Accelerate BLAS: shadow the built-in dgemm words ----
\ Same ( alpha A B beta C -- R ) contract, fresh R; words compiled after this
\ load bind to these, earlier compilations keep the built-in kernels.
\ The vendored shared library is the platform seam: BLAS and LAPACKE share
\ its one handle (Accelerate re-exported on macOS, OpenBLAS as an ELF
\ dependency on Linux).

binary-dir "/external/lapacke/liblapacke_telic.so" + ffi-open
dup "cblas_dgemm" [
					   :int :int :int \ order transa transb
					   :int :int :int \ m n k
					   :double :ptr :int \ alpha a lda
					   :ptr :int \ b ldb
					   :double :ptr :int \ beta c ldc
				   ] :void ffi-function (cblas-dgemm)
dup "cblas_dgemv" [
					   :int :int \ order transa
					   :int :int \ m n
					   :double :ptr :int \ alpha a lda
					   :ptr :int \ x incx
					   :double :ptr :int \ beta y incy
				   ] :void ffi-function (cblas-dgemv)
>side

( m -- columns ) \ the row-major leading dimension
: leading-dim dim swap drop ; internal

( alpha A B beta C ta tb -- R ) \ R = alpha op(A) op(B) + beta C via cblas
: accel-dgemm
	| alpha a b beta c ta tb |
	alpha float? beta float? and not if
		alpha type-of beta type-of
		"alpha and beta must be floats; got {1} and {0}" format throw
	then
	a matrix? b matrix? and c matrix? and not if
		a type-of b type-of c type-of
		"A, B, C must be matrices; got {2}, {1}, {0}" format throw
	then

	ta if a dim swap drop else a dim drop then to product-rows
	ta if a dim drop else a dim swap drop then to k
	tb if b dim drop else b dim swap drop then to n
	tb if b dim swap drop else b dim drop then to inner-b
	inner-b k = not if
		product-rows k inner-b n
		"inner dimensions must match (op(A) is {3}x{2}, op(B) is {1}x{0})" format throw
	then
	c dim swap drop n = c dim drop product-rows = and not if
		product-rows n c dim swap
		"C must be {3}x{2} to match the product, but is {1}x{0}" format throw
	then

	c copy to r
	101 111 ta + 111 tb + product-rows n k alpha
	a matrix>pointer a leading-dim
	b matrix>pointer b leading-dim
	beta
	r matrix>pointer n
	(cblas-dgemm)
	r ; internal

: dgemm-nn 0 0 accel-dgemm ;
: dgemm-tn 1 0 accel-dgemm ;
: dgemm-nt 0 1 accel-dgemm ;
: dgemm-tt 1 1 accel-dgemm ;

' matmul constant (native-matmul) internal

( A B -- A·B ) \ the plain matrix product: the matrix.c loop under 24x24 of
\ work, cblas dgemm above it (bench/stats/matmul-native-vs-blas.telic)
: matmul
	| a b |
	a dim to inner to rows
	b dim to columns to b-rows
	b-rows inner = not if
		rows inner b-rows columns
		"inner dimensions must match (A is {3}x{2}, B is {1}x{0})" format throw
	then

	rows inner * columns * 13824 > if
		1 a b 0 rows columns 0-matrix dgemm-nn
	else
		a b (native-matmul) execute
	then ;

( alpha A x beta y ta -- r ) \ r = alpha op(A) x + beta y via cblas, x and y columns
: accel-dgemv
	| alpha a x beta y ta |
	a dim to cols to rows
	x dim to x-cols to x-rows
	y dim to y-cols to y-rows
	ta if rows else cols then to x-len
	ta if cols else rows then to y-len
	x-cols 1 = x-rows x-len = and not if
		x-len "dgemv: x must be a column of length {0}" format throw
	then
	y-cols 1 = y-rows y-len = and not if
		y-len "dgemv: y must be a column of length {0}" format throw
	then

	\ beta 0 means cblas never reads y, so a fresh column serves and the copy of
	\ y's elements is dead work
	beta 0 = if y-len 1 0-matrix else y copy then to r
	101 111 ta + rows cols alpha
	a matrix>pointer cols
	x matrix>pointer 1
	beta
	r matrix>pointer 1
	(cblas-dgemv)
	r ; internal

: dgemv-n 0 accel-dgemv ;
: dgemv-t 1 accel-dgemv ;

side>

dup "LAPACKE_dgesvd" [
						 :int :int :int \ matrix_layout jobu jobvt
						 :int :int \ m n
						 :ptr :int \ a (input matrix) lda
						 :ptr \ s (singular values)
						 :ptr :int \ u (left vectors) ldu
						 :ptr :int \ vt (right vectors) ldvt
						 :ptr \ superb (workspace)
					 ] :int ffi-function (dgesvd)

dup "LAPACKE_dgelsd" [
						 :int :int :int :int \ matrix_layout m n nrhs
						 :ptr :int \ a (design matrix) lda
						 :ptr :int \ b (rhs, overwritten with the solution) ldb
						 :ptr :double :ptr \ s (singular values) rcond rank
					 ] :int ffi-function (dgelsd)

dup "LAPACKE_dgels" [
						:int :int :int :int :int \ matrix_layout trans m n nrhs
						:ptr :int \ a (design matrix, overwritten with the QR factors) lda
						:ptr :int \ b (rhs, overwritten with the solution in its first n rows) ldb
					] :int ffi-function (dgels)

dup "LAPACKE_dpotrf" [
						 :int :int :int \ matrix_layout uplo n
						 :ptr :int \ a (overwritten with the cholesky factor) lda
					 ] :int ffi-function (dpotrf)

dup "LAPACKE_dpotrs" [
						 :int :int :int :int \ matrix_layout uplo n nrhs
						 :ptr :int \ a (the cholesky factor) lda
						 :ptr :int \ b (rhs, overwritten with the solution) ldb
					 ] :int ffi-function (dpotrs)
drop

: svd ( A -- U S VT )
	copy to a
	a dim to cols to rows
	rows cols < if rows else cols then to min-dim
	rows min-dim 0-matrix to u
	1 min-dim 0-matrix to singular-values
	min-dim cols 0-matrix to vt
	1 min-dim 1- 0-matrix to superb

	101 83 83 rows cols \ LAPACK_ROW_MAJOR, jobu='S', jobvt='S' (thin SVD)
	a matrix>pointer cols
	singular-values matrix>pointer
	u matrix>pointer min-dim
	vt matrix>pointer cols
	superb matrix>pointer

	(dgesvd) to info
	info if info "svd: dgesvd failed (info={0})" format throw then

	u singular-values vt ;

( mat y -- beta ) \ ordinary least squares via LAPACKE dgelsd ; mat is m x n (m >= n)
: fit-linear 
	| mat y |
	mat dim to cols to rows
	rows cols < if 
		rows cols "fit-linear: need at least as many observations as predictors; got {1}x{0}" format 
		throw
	then

	mat copy to a
	y copy to b
	1 cols 0-matrix to singular-values
	1 int-segment to rank

	101 rows cols 1
	a matrix>pointer cols
	b matrix>pointer 1
	singular-values matrix>pointer
	-1.0
	rank segment>pointer

	(dgelsd) to info
	info if 
		info "fit-linear: dgelsd failed (info={0})" format
		throw
	then

	b 0 cols 0 1 submatrix ;

( augmented-matrix -- betas ) \ augmented is observations x (predictors + 1) ; last column is y
: fit-augmented
	| aug-mat |

	aug-mat dim to cols to rows
	aug-mat 0 rows 0 cols 1- submatrix
	aug-mat 0 rows cols 1- cols submatrix
	fit-linear ;

\ ---- constrained least squares ----

( X passive -- mat ) \ the passive columns of X, side by side in passive order
: passive-columns
	[: 2 pick swap @j :] map nip
	null ' hstack reduce ; internal

( X y -- beta ) \ nonnegative least squares (beta >= 0) by the Lawson-Hanson
\ active set over fit-linear subset solves: finite, exact zeros on the active
\ set; at the answer the passive gradient is ~0 and the active gradient <= 0
: fit-nonnegative
	| X y |
	X dim to n-predictors drop
	X transpose to Xt
	Xt y matmul to gradient
	gradient abs max 1e-10 * to tolerance

	n-predictors 1 0-matrix to beta
	n-predictors 1 0-matrix to passive-mask
	[ ] to passive
	0 to rounds

	begin
		++ rounds
		rounds n-predictors 3 * 10 + > if
			"fit-nonnegative: did not converge" throw
		then

		\ dual test: the most positive gradient among the active coordinates
		-1 to best-index
		tolerance to best-gradient
		0 n-predictors 1 do candidate
			passive-mask candidate @e 0= if
				gradient candidate @e best-gradient > if
					gradient candidate @e to best-gradient
					candidate to best-index
				then
			then
		loop
		best-index 0 < if leave then

		passive best-index add-last! to passive
		passive-mask 1 best-index !e drop

		\ feasibility loop: solve on the passive columns; while the solve
		\ leaves the orthant, step to the boundary and demote what it zeroed
		begin
			X passive passive-columns y fit-linear to z
			z min 0 > if
				0 passive size 1 do position
					beta z position @e passive position @i !e drop
				loop
				true
			else
				1 to alpha
				-1 to pivot
				0 passive size 1 do position
					z position @e 0 <= if
						beta passive position @i @e to beta-entry
						beta-entry beta-entry z position @e - / to step-limit
						step-limit alpha < if
							step-limit to alpha
							passive position @i to pivot
						then
					then
				loop

				0 passive size 1 do position
					passive position @i to column-index
					beta column-index @e to beta-entry
					beta
					beta-entry z position @e beta-entry - alpha * +
					column-index !e drop
				loop
				pivot 0 < not if beta 0 pivot !e drop then

				[ ] to still-passive
				0 passive size 1 do position
					passive position @i to column-index
					beta column-index @e 0 <= column-index pivot = or if
						passive-mask 0 column-index !e drop
						beta 0 column-index !e drop
					else
						still-passive column-index add-last! to still-passive
					then
				loop
				still-passive to passive
				false
			then
		until

		Xt y X beta matmul - matmul to gradient
	again
	beta ;

( X y -- weights ) \ least squares on the probability simplex: weights >= 0,
\ summing to exactly 1. The sum constraint enters as a mu-weighted ones row,
\ whose O(1/mu^2) error the final renormalization removes
: fit-simplex
	| X y |
	X abs max 1 max2 1e3 * to mu
	X dim nip to n-predictors

	X 1 n-predictors 0-matrix mu + vstack
	y [ mu ] vector vstack
	fit-nonnegative to weights

	weights sum to total
	total 0 <= if "fit-simplex: empty support" throw then
	weights total / ;

\ ---- design matrices and the shared regression pipeline ----
\ Moved out of the embedded library: every one of these serves a fit, and the
\ fits are here.

( column -- m ) \ one 0/1 indicator column per distinct value above the first
\ (the reference); levels in val_cmp order, as column>set lists them; a
\ missing cell lands in no column
: column>indicators
	| column |
	column column>array [: null? not :] filter array>set sort to levels
	levels size 2 < if "column>indicators: needs at least 2 distinct values" throw then
	column levels 1 skip
	[: 2 pick swap eq :] map nip
	null ' hstack reduce ;

( design column sym -- design ) \ add one 0/1 column per non-reference level to a
\ design dataset, keyed sym=level; levels and keys derive from the same data
: indicators!
	| design column prefix |
	column column>array [: null? not :] filter array>set sort to levels
	levels size 2 < if "indicators!: needs at least 2 distinct values" throw then
	levels 1 skip
	[: level |
		design column level eq prefix level "{1}={0}" format string>symbol !
	:] map drop
	design ;

( design sym -- design ) \ replace a categorical column with its sym=level indicators
: expand-indicators!
	| design column |
	design column @ to values
	design values column indicators!
	column delete-at ;

( X/design -- X'/design ) \ matrix: prepend a column of 1s so beta[0] is the
\ intercept; design dataset: add an :intercept ones column (after at least one
\ column exists — the rows are read from the design)
: with-intercept
	dup frame? if
		dup keys size 0= if "with-intercept: empty design (add a column first)" throw then
		dup n-rows 1 0-matrix 1 + :intercept !
	else
		dup dim drop
		1 0-matrix 1 + \ rows x 1 column of ones
		swap augment
	then ;


( X y max-iterations tolerance -- beta ) \ logistic regression by IRLS; X is n×k (incl. intercept), y in {0,1}
: fit-logistic
	| x y max-iterations tolerance |
	x dim to cols to rows
	cols 1 0-matrix to beta
	0 to iterations
	0 to converged

	begin
		1 x beta 0 rows 1 0-matrix dgemm-nn to eta \ eta = X*beta
		eta sigmoid to mu
		mu dup 1 swap - * to w
		w sqrt to sqrt-w
		sqrt-w x * to xw \ weighted design sqrt(w)*X
		xw svd drop drop dup * row-sums to h \ hat diagonals h_i = sum_j U_ij^2

		y mu - h 0.5 mu - * + to r \ Firth residual: (y-mu) + h(0.5-mu)
		eta r w / + to z
		xw sqrt-w z * fit-linear to new-beta
		new-beta beta - dup * sum sqrt to delta
		new-beta to beta

		++ iterations
		delta tolerance < to converged
		converged iterations max-iterations > or
	until

	converged not if
		iterations "fit-logistic: did not converge in {0} iterations" format throw
	then
	beta ;

( design target -- beta|null ) \ least squares by Householder QR (dgels), the same
\ system fit-linear solves and the same conditioning, for several times fewer flops
\ than dgelsd's divide-and-conquer SVD; null when dgels reports the design
\ rank-deficient, leaving the caller the dgelsd path and its minimum-norm answer
: solve-qr
	| design target |
	design dim to cols to rows
	design copy to a
	target copy to b

	101 78 rows cols 1 \ row-major, trans 'N', one right-hand side
	a matrix>pointer cols
	b matrix>pointer 1
	(dgels) to info
	info if null exit then

	b 0 cols 0 1 submatrix ; internal

( X y max-iterations tolerance lambda -- beta ) \ L2-regularized logistic by IRLS:
\ lambda multiplies ||beta||^2/2 in the objective, column 0 (the intercept) is
\ unpenalized, no Firth term; lambda 0 is the plain MLE. The penalty enters each
\ weighted least-squares step as sqrt(lambda)*I rows appended to the design, which
\ solve-qr solves; the normal equations are deliberately not used here, since
\ squaring the design costs about half the digits and floors the beta step near
\ 1e-6 at small lambda, above the 1e-8 tolerance callers ask for.
: fit-logistic-ridge
	| x y max-iterations tolerance lambda |
	x dim to cols to rows
	lambda sqrt cols diagonal-matrix 0 0 0 !i,j to penalty
	cols 1 0-matrix to zeros
	cols 1 0-matrix to beta
	0 to iterations
	0 to converged

	begin
		1 x beta 0 rows 1 0-matrix dgemm-nn to eta \ eta = X*beta
		eta sigmoid
		dup 1e-10 < 1e-10 mesh
		dup 1 1e-10 - > 1 1e-10 - mesh to mu \ keep w = mu(1-mu) > 0 under separation
		mu dup 1 swap - * to w
		w sqrt to sqrt-w
		eta y mu - w / + to z
		sqrt-w x * penalty vstack to design
		sqrt-w z * zeros vstack to target
		design target solve-qr to new-beta
		new-beta null? if
			design target fit-linear to new-beta
		then
		new-beta beta - dup * sum sqrt to delta
		new-beta to beta

		++ iterations
		delta tolerance < to converged
		converged iterations max-iterations > or
	until

	converged not if
		iterations "fit-logistic-ridge: did not converge in {0} iterations" format throw
	then
	beta ;

( augmented -- beta ) \ logistic fit of an [X | y] block, standard convergence
: fit-augmented-logistic
	| aug |
	aug dim to cols to rows
	aug 0 rows 0 cols 1- submatrix
	aug 0 rows cols 1- cols submatrix
	100 1e-8 fit-logistic ;

( X beta -- probabilities ) \ sigmoid of the linear predictor
: predict-logistic
	1 -rot over dim drop 1 0-matrix 
	0 swap dgemm-nn 
	sigmoid ;


( train-units xy lambda -- beta ) \ ridge fit on the drawn units' rows of [1|X|y]
: cv-ridge-fit
	| xy lambda |
	flatten xy swap select-rows to rows
	rows n-columns 1 - to n-predictors
	rows 0 rows n-rows 0 n-predictors submatrix
	rows n-predictors @j
	50 1e-8 lambda fit-logistic-ridge ; internal

( beta test-units xy -- dev ) \ mean held-out deviance of beta
: cv-ridge-score
	| beta test xy |
	test flatten xy swap select-rows to rows
	rows n-columns 1 - to n-predictors
	1 rows 0 rows n-rows 0 n-predictors submatrix beta
	0 rows n-rows 1 0-matrix dgemm-nn sigmoid to p
	rows n-predictors @j p binomial-deviance rows n-rows / ; internal

( train test xy lambda -- loss ) \ one (lambda, fold) cell: fit, then score held-out
: cv-ridge-cell
	| train test xy lambda |
	train xy lambda cv-ridge-fit
	test xy cv-ridge-score ; internal

( X y units lambdas n-folds mapper -- fr ) \ the CV skeleton cv-logistic-ridge and
\ pcv-logistic-ridge instantiate: every (lambda, fold) cell is a pre-curried thunk,
\ deterministic, so the mapper choice cannot change the result
: cv-logistic-ridge-with
	| X y units lambdas n-folds mapper |
	X with-intercept y augment to xy
	units n-folds cv-folds to folds
	lambdas
	[: lambda |
		folds
		[: fold |
			fold 0 @i fold 1 @i xy lambda
			' cv-ridge-cell curry curry curry curry :]
		map :]
	map flatten
	' execute mapper execute
	vector lambdas size n-folds reshape row-means to losses
	{ :lambdas lambdas
	  :deviances losses
	  :best lambdas losses argmin @i } ; internal

( X y units lambdas n-folds -- fr ) \ ridge-logistic CV over a lambda grid:
\ { :lambdas :deviances :best }; X excludes the intercept (added internally,
\ unpenalized); units index rows — per-cluster index arrays give cluster CV
: cv-logistic-ridge ' map cv-logistic-ridge-with ;

( X y units lambdas n-folds -- fr ) \ cv-logistic-ridge with the cells run under
\ pmap; identical results, the cells being deterministic
: pcv-logistic-ridge ' pmap cv-logistic-ridge-with ;


( -- [paths] ) \ libxgboost install locations on macOS, preference order
: mac-xgboost-libs
	[ "/opt/homebrew/lib/libxgboost.dylib" "/usr/local/lib/libxgboost.dylib" ] ; internal

( -- [paths] ) \ libxgboost install locations on Linux, preference order; the
\ distro runtime package ships only the versioned soname (the unversioned
\ symlink belongs to its -dev package), so both names appear
: linux-xgboost-libs
	[ "/usr/local/lib/libxgboost.so" "/usr/lib/libxgboost.so"
	  "/usr/lib/x86_64-linux-gnu/libxgboost.so"
	  "/usr/lib/x86_64-linux-gnu/libxgboost.so.0"
	  "/usr/lib/aarch64-linux-gnu/libxgboost.so"
	  "/usr/lib/aarch64-linux-gnu/libxgboost.so.0" ] ; internal

( -- path ) \ XGBOOST_LIB if set, else the first install location present, else
\ the bare soname, leaving the search to the loader's own path
: xgb-lib-path
	"XGBOOST_LIB" env dup null? not if
		exit
	then drop

	mac-xgboost-libs linux-xgboost-libs concat ' file-exists? find-first
	dup null? if
		drop "libxgboost.so"
	then ; internal

xgb-lib-path ffi-open
dup "XGDMatrixCreateFromDense" [ :string :string :ptr ] :int ffi-function (xgd-from-dense)
dup "XGDMatrixSetInfoFromInterface" [ :ptr :string :string ] :int ffi-function (xgd-set-info)
dup "XGDMatrixFree" [ :ptr ] :int ffi-function (xgd-free)
dup "XGBoosterCreate" [ :ptr :long :ptr ] :int ffi-function (xgb-create)
dup "XGBoosterSetParam" [ :ptr :string :string ] :int ffi-function (xgb-set-param)
dup "XGBoosterUpdateOneIter" [ :ptr :int :ptr ] :int ffi-function (xgb-update)
dup "XGBoosterPredictFromDMatrix" [ :ptr :ptr :string :ptr :ptr :ptr ] :int ffi-function (xgb-predict-raw)
dup "XGBoosterFree" [ :ptr ] :int ffi-function (xgb-booster-free)
dup "XGBoosterFeatureScore" [ :ptr :string :ptr :ptr :ptr :ptr :ptr ] :int ffi-function (xgb-feature-score)
dup "XGBoosterGetNumFeature" [ :ptr :ptr ] :int ffi-function (xgb-num-feature)
dup "XGBoosterSaveModel" [ :ptr :string ] :int ffi-function (xgb-save-model)
dup "XGBoosterLoadModel" [ :ptr :string ] :int ffi-function (xgb-load-model)
dup "XGBGetLastError" [ ] :string ffi-function (xgb-last-error)
drop

( status -- ) \ nonzero xgboost statut throws the library's last message
: xgb-check if (xgb-last-error) throw then ; internal

( matrix -- json ) \ NumPy __array_interface__ (float64) over a matrix's row-major buffer
: array-interface
	| described-matrix |
	{ :data [ described-matrix matrix>pointer pointer>address :0 ]
	  :shape [ described-matrix dim ]
	  :typestr "<f8"
	  :version 3 }
	frame>json ; internal

( X y fit-params -- booster ) \ train a booster on features X (nxk) and response y (nx1)
\ params are keyed by xgboost parameter name; :rounds drives the boosting loop (default 100)
: fit-xgb
	| X y params |
	params :rounds 100 @or to rounds

	pointer-cell to dmatrix-cell
	X array-interface "{""missing"": NaN}" dmatrix-cell (xgd-from-dense) xgb-check
	dmatrix-cell pointer-deref to dmatrix
	dmatrix "label" y array-interface (xgd-set-info) xgb-check

	pointer-cell to booster-cell
	dmatrix-cell 1 booster-cell (xgb-create) xgb-check
	booster-cell pointer-deref to booster

	params keys [: :rounds = not :] filter
	[: key |
	   booster key "{0}" format
	   params key @ "{0}" format
	   (xgb-set-param) xgb-check
	:] each

	[: i |
	   booster i dmatrix (xgb-update) xgb-check
	:] rounds i-times

	dmatrix (xgd-free) xgb-check
	dmatrix-cell ffi-free booster-cell ffi-free
	booster ;

( booster X -- predictions ) \ n×1 scores for an n×k feature matrix; booster is not freed
: xgb-predict
	| booster X |
	pointer-cell to dmatrix-cell
	X array-interface "{""missing"": NaN}" dmatrix-cell (xgd-from-dense) xgb-check
	dmatrix-cell pointer-deref to dmatrix

	pointer-cell to shape-cell
	pointer-cell to dim-cell
	pointer-cell to result-cell
	booster dmatrix
	{ :type 0 :iteration_begin 0 :iteration_end 0 :strict_shape :0 :training :0 } frame>json
	shape-cell dim-cell result-cell (xgb-predict-raw) xgb-check

	result-cell pointer-deref X n-rows floats>matrix

	dmatrix (xgd-free) xgb-check
	dmatrix-cell ffi-free shape-cell ffi-free dim-cell ffi-free result-cell ffi-free ;

( booster -- ) \ free a booster handle
: xgb-free (xgb-booster-free) xgb-check ;

( booster path -- ) \ write the booster; the path extension picks the format, ".json" or ".ubj"
: xgb-save (xgb-save-model) xgb-check ;

( path -- booster ) \ read a booster written by xgb-save or by xgboost elsewhere
: xgb-load
	| path |
	pointer-cell to no-matrices
	pointer-cell to booster-cell
	no-matrices 0 booster-cell (xgb-create) xgb-check
	booster-cell pointer-deref to booster
	booster path (xgb-load-model) xgb-check
	no-matrices ffi-free booster-cell ffi-free
	booster ;

( booster importance-type -- scores ) \ k×1 per-feature importance, row i is feature i
\ importance-type is "gain" "weight" "cover" "total_gain" or "total_cover"; a feature
\ never split on scores 0. Rank with: matrix>array argsort reverse (indices best-first)
: xgb-importance
	| booster type |
	pointer-cell to k-cell
	booster k-cell (xgb-num-feature) xgb-check
	k-cell pointer-long to k
	k iota [: "{0}" format :] map to feature-names

	pointer-cell to n-cell
	pointer-cell to features-cell
	pointer-cell to dim-cell
	pointer-cell to shape-cell
	pointer-cell to scores-cell
	booster { :importance_type type :feature_names feature-names } frame>json
	n-cell features-cell dim-cell shape-cell scores-cell (xgb-feature-score) xgb-check

	n-cell pointer-long to n
	k 1 0-matrix to dense
	n 0 > if
		scores-cell pointer-deref n floats>matrix matrix>array to scores
		features-cell pointer-deref to names
		[: i |
		   dense scores i @i names i pointer-string-at string>number 0 !i,j drop
		:] n i-times
	then

	k-cell ffi-free n-cell ffi-free features-cell ffi-free
	dim-cell ffi-free shape-cell ffi-free scores-cell ffi-free
	dense ;


\ The Generalized Linear Model. A family is a frame of four stack quotations —
\ :inverse-link ( eta -- mu ), :mean-derivative ( eta -- dmu/deta ),
\ :variance ( mu -- V ), :deviance ( y mu -- d ) the per-observation unit
\ deviance — and :dispersion, :fixed (phi is 1) or :pearson (phi estimated).
\ Logs of y or 1 - y sit on 1e-300 max2 so a zero contributes 0, not NaN.
{ :inverse-link ' exp
  :mean-derivative ' exp
  :variance [: dup * :]
  :deviance [: y mu | y mu - mu / y mu / ln - 2 * :]
  :dispersion :pearson
  :effect :rate-ratio
} to gamma-log

{ :inverse-link ' exp
  :mean-derivative ' exp
  :variance ' identity
  :deviance [: y mu | y 1e-300 max2 mu / ln y * y mu - - 2 * :]
  :dispersion :fixed
  :effect :rate-ratio
} to poisson-log

{ :inverse-link ' identity
  :mean-derivative [: drop 1 :]
  :variance [: drop 1 :]
  :deviance [: - dup * :]
  :dispersion :pearson
} to gaussian-identity

( eta -- mu ) \ the logistic mean with eta clamped to [-30, 30], so mu stays
\ inside (0, 1) under separation — R's binomial() threshold
: clamped-logit-mean -30 max2 30 min2 sigmoid ; internal

( eta -- dmu/deta ) \ mu (1 - mu) at the clamped eta, floored at machine epsilon
: clamped-logit-slope clamped-logit-mean dup 1 swap - * 2.220446e-16 max2 ; internal

( y mu -- d ) \ binomial unit deviance 2 [ y ln(y/mu) + (1-y) ln((1-y)/(1-mu)) ]
: binomial-deviance-unit
	| y mu |
	y 1e-300 max2 mu / ln y *
	1 y - 1e-300 max2 1 mu - / ln 1 y - * + 2 * ; internal

{ :inverse-link ' clamped-logit-mean
  :mean-derivative ' clamped-logit-slope
  :variance [: dup 1 swap - * :]
  :deviance ' binomial-deviance-unit
  :dispersion :fixed
  :effect :odds-ratio
} to binomial-logit

{ :inverse-link ' clamped-logit-mean
  :mean-derivative ' clamped-logit-slope
  :variance [: dup 1 swap - * :]
  :deviance ' binomial-deviance-unit
  :dispersion :pearson
  :effect :odds-ratio
} to quasibinomial-logit

( X beta -- eta ) \ the linear predictor
: glm-eta
	| x beta |
	1 x beta 0 x dim drop 1 0-matrix dgemm-nn ; internal

( X y weights family max-iterations tolerance -- beta ) \ IRLS with prior
\ weights: the working weight is weights times (dmu/deta)^2 / V(mu). Stops when
\ the relative change in weighted deviance |d - d'| / (|d| + 0.1) falls below
\ tolerance (R's criterion); a family without :deviance stops on |beta - beta'|
: fit-glm-weighted
	| x y prior-weights family max-iterations tolerance |

	x dim to cols to rows
	family :inverse-link @ to inverse-link
	family :mean-derivative @ to mean-derivative
	family :variance @ to variance
	family :deviance null @or to deviance
	cols 1 0-matrix to beta
	0 to iterations
	0 to converged

	begin
		1 x beta 0 rows 1 0-matrix dgemm-nn to eta
		eta inverse-link execute to mu
		eta mean-derivative execute to mean-slope
		eta y mu - mean-slope / + to working-response

		mean-slope dup * mu variance execute / prior-weights * to working-weight
		working-weight sqrt to sqrt-weight
		sqrt-weight x * sqrt-weight working-response * fit-linear to new-beta
		new-beta beta - dup * sum sqrt to delta
		new-beta to beta

		++ iterations
		deviance null? if
			delta tolerance < to converged
		else
			y mu deviance execute prior-weights * sum to deviance-total
			iterations 1 > if
				deviance-total previous-deviance - abs deviance-total abs 0.1 + / tolerance < to converged
			then
			deviance-total to previous-deviance
		then
		converged iterations max-iterations > or
	until

	converged not if
		iterations "fit-glm: did not converge in {0} iterations" format throw
	then

	beta ;

( X y family max-iterations tolerance -- beta ) \ IRLS with unit weights
: fit-glm
	| x y family max-iterations tolerance |
	x y x dim drop 1 0-matrix 1 + family max-iterations tolerance fit-glm-weighted ;

( X y weights beta family -- phi ) \ the dispersion at beta: 1 for a :fixed
\ family, else Pearson chi-square sum w (y - mu)^2 / V(mu) over n - p
: glm-dispersion
	| x y prior-weights beta family |
	family :dispersion :pearson @or :fixed = if 1 exit then
	x beta glm-eta family :inverse-link @ execute to mu
	y mu - dup * mu family :variance @ execute / prior-weights * sum
	x dim - / ;

( X y weights beta family -- cov ) \ phi times (X'WX)^-1 at beta, W the IRLS
\ working weight times the prior weights, via the SVD of sqrt(W) X
: glm-covariance
	| x y prior-weights beta family |
	x beta glm-eta to eta
	eta family :inverse-link @ execute to mu
	eta family :mean-derivative @ execute to mean-slope
	mean-slope dup * mu family :variance @ execute / prior-weights * sqrt to sqrt-weight
	sqrt-weight x * svd to vt to singular-values drop
	vt 1 singular-values / transpose * to scaled-vt
	x y prior-weights beta family glm-dispersion
	scaled-vt transpose scaled-vt matmul * ;

( X y max-iterations tolerance -- beta ) \ gamma regression, log link, by IRLS
: fit-gamma
	gamma-log -rot fit-glm ;


( X y max-iterations tolerance -- beta ) \ poisson regression, log link, by IRLS
: fit-poisson
	poisson-log -rot fit-glm ;


\ The regression pipeline: a dataset in, a model frame out. The fit receives
\ ( X y w -- beta ); inside the pipeline the three travel as one augmented
\ matrix [X | y | w] so that bootstrap resampling carries each row's weight.
( augmented -- X y w ) \ the three parts of an [X | y | w] matrix
: split-augmented
	| augmented |
	augmented dim to cols to rows
	augmented 0 rows 0 cols 2 - submatrix
	augmented 0 rows cols 2 - cols 1- submatrix
	augmented 0 rows cols 1- cols submatrix ; internal

( X y w -- beta ) \ weighted least squares: rows scaled by sqrt w into fit-linear
: fit-weighted-linear
	sqrt to root-w to y to x
	root-w x * root-w y * fit-linear ;

( betas replications j -- column )
: coefficient-column
	| betas replications j |
	betas [: b | b j 0 @i,j :] map replications 1 matrix ; internal

( beta betas replications j -- frame )
: coefficient-summary
	| beta betas replications j |
	betas replications j coefficient-column to column
	column 0.95 ci to high to low
	{ :estimate beta j 0 @i,j
	  :se column std
	  :bias column mean beta j 0 @i,j -
	  :ci-low low
	  :ci-high high
	} ; internal

( augmented fit beta replications -- frames covariance ) \ one bootstrap summary
\ per coefficient, and the sample covariance of the replicate coefficient vectors
: bootstrap-summaries
	| augmented fit beta replications |
	augmented [: split-augmented fit execute :] replications bootstrap to betas
	0 beta size 1- range
	[: j | beta betas replications j coefficient-summary :]
	map

	betas ' transpose map dup 1 skip swap 0 @i ' vstack reduce to stacked
	stacked stacked column-means - to centered
	centered transpose centered matmul replications 1- / ; internal

( X y w beta family -- frames covariance ) \ one Wald summary per coefficient
\ from the GLM covariance, and that covariance
: wald-summaries
	| x y w beta family |
	x y w beta family glm-covariance to covariance
	covariance diagonal sqrt matrix>array to standard-errors
	0.975 qnorm to z-crit
	0 beta size 1- range
	[: j |
		beta j 0 @i,j to estimate
		standard-errors j @i to se
		estimate se / to z
		{ :estimate estimate
		  :se se
		  :z z
		  :p z abs negate pnorm 2 *
		  :ci-low estimate z-crit se * -
		  :ci-high estimate z-crit se * +
		} :]
	map covariance ; internal

( dataset spec -- mat ) \ a column named by a symbol, or the n x 1 matrix given
: column-or-matrix
	| dataset spec |
	spec symbol? if dataset spec 1 array dataset>matrix else spec then ; internal

( dataset predictors response weights replications fit family -- model )
\ response: a column symbol or an n x 1 matrix; weights: a column symbol, an
\ n x 1 matrix, or null for unit weights. fit is ( X y w -- beta ).
\ replications 0: Wald inference from the GLM covariance under family; B > 0:
\ B bootstrap refits. Rows with a missing cell in any used column drop first.
: regress-with
	| dataset predictors response weights replications fit family |
	dataset predictors dataset>matrix with-intercept to x
	dataset response column-or-matrix to y
	weights null? if x dim drop 1 0-matrix 1 + else dataset weights column-or-matrix then to w
	x y augment w augment to augmented
	augmented dup nan? row-sums 0 eq where select-rows to augmented
	augmented split-augmented to weight-column to responses to design
	design responses weight-column fit execute to beta
	design dim drop to rows

	replications 0 > if
		augmented fit beta replications bootstrap-summaries
		:bootstrap
	else
		design responses weight-column beta family wald-summaries
		:wald
	then to inference to covariance to coefficients

	{ :coefficients coefficients
	  :covariance covariance
	  :estimates beta
	  :predictors [ :intercept ] predictors concat
	  :response response symbol? if response else null then
	  :design design
	  :responses responses
	  :weights weight-column
	  :family family
	  :n-rows rows
	  :replications replications
	  :inference inference
	} ;

( dataset predictors response replications -- model ) \ OLS; Wald at 0 replications
: linear-regression
	null swap ' fit-weighted-linear gaussian-identity regress-with ;

( dataset predictors response replications -- model ) \ Firth logistic; at 0
\ replications the Wald covariance is binomial-logit's at the Firth estimate
: logistic-regression
	null swap [: drop 100 1e-8 fit-logistic :] binomial-logit regress-with ;

( dataset predictors response weights family replications -- model ) \ a GLM
\ under family; response a column symbol or n x 1 matrix, weights a column
\ symbol, an n x 1 matrix, or null for unit weights; 0 replications for Wald
: glm-regression
	| family replications |
	replications family 100 1e-8 ' fit-glm-weighted 3 ncurry family regress-with ;

( model -- fr ) \ { :n :n-terms :dispersion :deviance :null-deviance :pseudo-r2 }:
\ weighted deviance at the estimate, the intercept-only deviance, McFadden's 1 - d/d0
: regression-statistics
	| model |
	model :design @ to x
	model :responses @ to y
	model :weights @ to w
	model :estimates @ to beta
	model :family @ to family
	family :inverse-link @ to inverse-link
	family :deviance @ to deviance
	x beta glm-eta inverse-link execute to mu
	y mu deviance execute w * sum to residual-deviance
	x dim drop 1 0-matrix 1 + to ones
	ones y w family 100 1e-8 fit-glm-weighted to null-beta
	y ones null-beta glm-eta inverse-link execute deviance execute w * sum to null-deviance
	{ :n model :n-rows @
	  :n-terms x dim swap drop
	  :dispersion x y w beta family glm-dispersion
	  :deviance residual-deviance
	  :null-deviance null-deviance
	  :pseudo-r2 1 residual-deviance null-deviance / -
	} ;

( model -- dataset ) \ one row per term: :term and the coefficient summary's keys,
\ plus the family's :effect (exp of the estimate and bounds) when it has one
: regression-coefficients
	| model |
	model :predictors @ to terms
	model :coefficients @ to summaries
	model :family @ :effect null @or to effect
	0 terms size 1- range
	[: j |
		summaries j @i { :term terms j @i } merge to row
		effect null? not if
			row
			{ } row :estimate @ exp effect !
			row :ci-low @ exp effect "{0}-low" format string>symbol !
			row :ci-high @ exp effect "{0}-high" format string>symbol !
			merge to row
		then
		row :]
	map frames>dataset ;

( model -- ) \ print the fit statistics, then the coefficient table
: regression-report
	| model |
	model regression-statistics to statistics
	model :inference @ to inference
	model :family @ :effect null @or to effect
	statistics :n-terms @ statistics :n @ "n {0}, terms {1}" format . cr
	inference :wald = if
		"inference wald" . cr
	else
		model :replications @ "inference bootstrap, {0} replications" format . cr
	then
	statistics :dispersion @ "dispersion {0}" format . cr
	statistics :null-deviance @ statistics :deviance @ "deviance {0}, null deviance {1}" format . cr
	statistics :pseudo-r2 @ "pseudo-r2 {0}" format . cr
	cr
	[ :term :estimate :se ]
	inference :wald = if [ :z :p ] else [ :bias ] then concat
	[ :ci-low :ci-high ] concat
	effect null? not if
		effect effect "{0}-low" format string>symbol effect "{0}-high" format string>symbol 3 array concat
	then to ordered
	model regression-coefficients dup n-rows ordered headn ;

( model dataset -- mu ) \ the mean response the model predicts for every row of
\ the dataset, as n×1: the model's predictors gather from the dataset with an
\ intercept column, dgemm applies the estimates, the family's inverse link maps
\ the linear predictor; a row with a NaN predictor answers NaN
: predict-glm
	| model dataset |
	dataset model :predictors @ 1 skip dataset>matrix with-intercept
	model :estimates @ glm-eta
	model :family @ :inverse-link @ execute ;

( mats -- m)
: hstack-all 
	dup 1 skip swap 0 @i ' hstack reduce ;

( mats -- m )
: vstack-all 
	dup 1 skip swap 0 @i ' vstack reduce ;

( column-class X probs row-class-probs row-class -- block )
: information-block 
	| column-class X probs row-class-probs row-class |
	probs column-class @j
	row-class column-class = if 1 else 0 then swap -
	row-class-probs *
	X * to weighted-design
	1 X weighted-design 0 X n-columns dup 0-matrix dgemm-tn ;

( X y reference-class max-iterations tolerance -- beta )
: fit-multinomial-ridge
	| X y reference-class max-iterations tolerance lambda |
	
	y reference-class eq sum 0= if
		reference-class "fit-multinomial-ridge: reference class {0} has no observations in y" format throw
	then

	X n-columns to n-predictors
	reference-class y max 1+ iota [: 2 pick = not :] filter nip to classes
	classes size to n-nonreference-classes
	y classes [: 2 pick swap eq :] map nip hstack-all to response
	n-predictors n-nonreference-classes 0-matrix to beta

	n-predictors 1 0-matrix 1 + 0 0 0 !i,j to intercept-mask
	intercept-mask n-predictors n-nonreference-classes 0-matrix 1 + * to penalty-mask
	n-predictors n-nonreference-classes * identity-matrix
	  penalty-mask transpose n-predictors n-nonreference-classes * 1 reshape * lambda * to penalty-diagonal

	0 to iterations
	0 to converged

	begin
		1 X beta 0 X n-rows n-nonreference-classes 0-matrix dgemm-nn
		exp dup row-sums 1+ / to probs
		1 X response probs - 0 n-predictors n-nonreference-classes 0-matrix dgemm-tn
		lambda beta penalty-mask * * - to gradient

		n-nonreference-classes iota
		[: row-class |
		   n-nonreference-classes iota
		   [: column-class |
			  column-class X probs probs row-class @j row-class information-block :]
		   map hstack-all
		:] map vstack-all penalty-diagonal + to information

		information gradient transpose n-predictors n-nonreference-classes * 1 reshape
		fit-linear to delta

		beta delta n-nonreference-classes n-predictors reshape transpose + to beta

		delta dup * sum sqrt tolerance < to converged
		++ iterations
		converged iterations max-iterations > or
	until

	converged not if
		iterations "fit-multinomial-ridge: did not converge in {0} iterations" format throw
	then
	beta ;

( X y reference-class max-iterations tolerance -- beta ) \ plain multinomial MLE — fit-multinomial-ridge at lambda 0
: fit-multinomial
	0 fit-multinomial-ridge ;

( beta X reference-class -- probabilities ) \ n×K softmax probabilities in label order 0..K-1
: predict-multinomial
	| beta X reference-class |
	beta n-columns to n-nonreference-classes
	n-nonreference-classes 1 + to n-classes
	X n-rows to n-observations
	1 X beta 0 n-observations n-nonreference-classes 0-matrix dgemm-nn exp to class-weights
	class-weights row-sums 1 + to weight-total
	n-classes iota
	[: label |
		label reference-class = if
			1 weight-total /
		else
			class-weights label reference-class > if label 1 - else label then @j weight-total /
		then
	:] map hstack-all ;

\ ---- Negative binomial (NB2): variance mu + mu^2/theta, log link ----
\ theta is the dispersion; as theta grows the variance approaches the mean and
\ the model approaches Poisson. fit-glm handles beta at a fixed theta, so the
\ fit alternates that with a maximum-likelihood step for theta.

( mu theta -- variance ) \ NB2 variance function
: negative-binomial-variance
	| mu theta |
	mu mu sq theta / + ; internal

( theta -- family ) \ the GLM family at a known dispersion; theta is curried in.
: negative-binomial-log
	| theta |
	{ :inverse-link ' exp
	  :mean-derivative ' exp
	  :variance theta ' negative-binomial-variance curry
	  :deviance [: y mu |
		y 1e-300 max2 mu / ln y * y theta + mu theta + / ln y theta + * - 2 * :]
	  :dispersion :fixed
	  :effect :rate-ratio } ;

( X beta -- mu ) \ fitted means under the log link
: negative-binomial-mean
	| x beta |
	1 x beta 0 
	x dim drop 1 0-matrix
	dgemm-nn exp ; internal

( y mu -- theta ) \ moment estimate
: negative-binomial-theta-moment
	| y mu |
	y mu - dup * sum mu sum - to excess-variance
	excess-variance 0 > if
		mu dup * sum excess-variance /
	else 0
	then ; internal

( y mu theta -- loglik ) \ NB2 log-likelihood less the constant sum of lgamma(y+1)
: negative-binomial-loglik
	| y mu theta |
	y theta + lgamma
	theta lgamma -
	theta theta ln * +
	y mu ln * +
	theta y + mu theta + ln * -
	sum ; internal

( y mu -- theta ) \ maximum-likelihood dispersion at fixed means. Golden-section on
\ ln theta, bracketing the moment estimate a factor of bracket-factor each way; when
\ the sample shows no overdispersion the moment estimate is unusable and the bracket
\ centres on that factor instead, so an answer near the top means Poisson fits
: negative-binomial-theta
	| y mu |

	PHI 1- to section-fraction
	1000 ln to log-bracket-factor
	y mu negative-binomial-theta-moment 
	dup 0 > if ln else drop log-bracket-factor then to log-centre

	log-centre log-bracket-factor - to log-low
	log-centre log-bracket-factor + to log-high

	0 to narrowings
	begin narrowings 60 < while
		log-high log-high log-low - section-fraction * - to log-probe-low
		log-low log-high log-low - section-fraction * + to log-probe-high
		y mu log-probe-low exp negative-binomial-loglik
		y mu log-probe-high exp negative-binomial-loglik
		< if
			log-probe-low to log-low
		else
			log-probe-high to log-high
		then
		f++ narrowings
	repeat

	log-low log-high + 2 / exp ;


( X y max-iterations tolerance -- beta theta ) \ NB2 regression, log link: start from
\ the Poisson fit, then alternate a maximum-likelihood theta at the current means
\ with an IRLS beta at that theta until theta settles. max-iterations bounds both the
\ inner IRLS and the outer alternation, and tolerance serves both: since theta is a
\ function of the fitted means, it cannot be pinned tighter than beta is, so the
\ alternation also stops once a round no longer shrinks the change in theta
: fit-negative-binomial
	| x y max-iterations tolerance |

	x y max-iterations tolerance fit-poisson to beta
	0 to previous-theta
	0 to previous-change
	0 to rounds
	0 to converged

	begin 
		x beta negative-binomial-mean to mu
		y mu negative-binomial-theta to theta
		x y theta negative-binomial-log max-iterations tolerance fit-glm to beta

		++ rounds
		theta previous-theta - abs theta / to change

		change tolerance <
		  rounds 1 > change previous-change < not and
		or to converged \ settled, or no longer shrinking

		change to previous-change
		theta to previous-theta
		converged rounds max-iterations > or
	until

	converged not if
		rounds "fit-negative-binomial: theta did not settle in {0} rounds" format throw
	then

	beta theta ;

\ ---- generalized Pareto distribution (GPD): the peaks-over-threshold tail ----
\ Exceedances are the amounts by which observations pass a threshold, so they
\ are positive and measured from zero.

( shape scale exceedances -- nll ) \ negative log-likelihood; 1e10 where the parameters put an exceedance outside the support
: gpd-nll
	| shape scale exceedances |
	shape abs 1e-9 < if 1e10 exit then
	exceedances shape * scale / 1 + to scaled
	scaled min 0 <= if 1e10 exit then
	scaled ln sum 1 1 shape / + *
	exceedances num-elements scale ln * + ; internal

( exceedances -- shape scale ) \ maximum likelihood over a refining (shape, ln scale) grid
: gpd-fit
	| exceedances |
	0.3 to center-shape
	exceedances mean ln to center-lnscale
	0.6 to shape-span
	1.5 to lnscale-span
	center-shape to best-shape
	center-lnscale to best-lnscale
	1e10 to best-nll
	0 4 1 do round-i
		0 81 1 do grid-i
			center-shape grid-i 9 / ftruncate 4 - 4 / shape-span * + to trial-shape
			center-lnscale grid-i 9 mod 4 - 4 / lnscale-span * + to trial-lnscale
			trial-shape trial-lnscale exp exceedances gpd-nll to trial-nll
			trial-nll best-nll < if
				trial-nll to best-nll
				trial-shape to best-shape
				trial-lnscale to best-lnscale
			then
		loop
		best-shape to center-shape
		best-lnscale to center-lnscale
		shape-span 2 / to shape-span
		lnscale-span 2 / to lnscale-span
	loop
	best-shape best-lnscale exp ;

( shape scale p -- q ) \ the exceedance at probability p; shape 0 gives the exponential tail
: gpd-quantile
	| shape scale p |
	p 0 < p 1 >= or if
		p "gpd-quantile: expected a probability in [0, 1); got {0}" format throw
	then
	shape abs 1e-9 < if
		1 p - ln negate scale * exit
	then
	1 p - shape negate ^ 1 - scale * shape / ;

( shape scale -- draw ) \ one exceedance drawn from the tail, by inverse transform
: gpd-draw random gpd-quantile ; inline
