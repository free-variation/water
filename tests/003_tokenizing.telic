\ ==== brackets in colon ====

: nums [< 1 2 3 >] ;
nums .
: pair [ 10 20 ] ;
pair .
: combine [< 1 2 >] [< 2 3 >] union ;
combine .

clear

\ ==== semicolon delimits ====

\ ; is self-delimiting: no space needed before it
: sq dup *;
3 sq . cr

\ glued after a word call
: nine 3 sq;
nine . cr

\ ; inside a string literal stays literal
"a;b" . cr

\ see round-trips a glued definition
' sq see

clear

\ ==== bracket delimits ====

\ closers self-delimit: no space needed before ] or }
[ 1 2 3 4] . cr
{ :a 1} /a @ . cr

\ openers too: [ and { start their own token
[1 2 3 4 ] . cr
{:a 1 } /a @ . cr

\ fully glued on both sides
[1 2 3] . cr

\ two-char closers survive gluing: :] and >]
[:dup *:] 3 swap execute . cr
[< 1 2>] size . cr

\ the matrix typo from the field
[ 1 2 3 4] 2 2 matrix .

\ path predicates keep their brackets: no split inside [...]
{ :a { :n 1 } :b { :n 5 } } /*/n[.>2] select-values . cr

\ strings unaffected
"a]b{c" . cr

clear
