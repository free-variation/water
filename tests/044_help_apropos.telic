\ ==== help ====

\ man ( xt -- fr ): frame of a word's reference entry, or null if undocumented.
\ lookup ( "name" -- xt ): parse the next word at run time, push its xt.
\ help ( "name" -- ): core.telic convenience, prints a word's man frame.

\ a runtime word: the three base keys carry the documented strings
' sin man :word @ "sin" = . cr                    \ 1
' sin man :effect @ "( a -- sin a )" = . cr       \ 1
' sin man :summary @ "sine (radians)" = . cr      \ 1

\ a runtime word also carries the three cost keys, as strings
' sin man :ops has? . cr                          \ 1
' sin man :ops @ "2" = . cr                       \ 1
' sin man :alloc has? . cr                        \ 1
' sin man :order has? . cr                        \ 1
' sin man size . cr                               \ 7 (base + cost keys + :examples)

\ a compile-time word has the base keys but no cost keys
' if man :word @ "if" = . cr                      \ 1
' if man :ops has? . cr                           \ 0
' if man :alloc has? . cr                         \ 0
' if man :order has? . cr                         \ 0
' if man size . cr                                \ 4 (base keys + :examples)

\ an embedded-library word is documented like any other
' 2dup man :summary @ "core.telic: duplicate the top two items" = . cr   \ 1

\ man resolves its own entry
' man man :word @ "man" = . cr                    \ 1

\ a word with no reference entry returns null
: fresh-this-session 1 ;
' fresh-this-session man null = . cr              \ 1

\ a unit word synthesizes its entry from the unit's definition
' kg man :summary @ "unit: base unit of its own dimension" = . cr   \ 1
' newton man :summary @ . cr                      \ unit: m.kg.s^-2
' km man :summary @ . cr                          \ unit: m × 1000
' ¢ man :effect @ "( n -- q )" = . cr             \ 1
base unit furlong
' furlong man null = . cr                         \ 0

\ see reconstructs a unit as a description line
' newton see

\ lookup parses the next word and pushes its xt
lookup sin man :word @ "sin" = . cr               \ 1

\ help parses the next word and prints its man frame
help sin

\ a word with reference examples carries them as { :code :output } frames,
\ and help prints each below the frame
' nip man :examples has? . cr                     \ 1
' nip man :examples @ size . cr                   \ 1
' nip man :examples @ 0 @i @code . cr             \ 1 2 nip . cr
' sin man :examples has? . cr                     \ 1
help nip

\ an unknown name prints a plain message and does not error (line ends ok)
help no-such-word

\ every runnable line of the bare-help cheat sheet does what it claims
3 4 + . cr                                        \ 7
1 2 .s cr                                         \ 1 2
clear
: sq dup * ; 5 sq . cr                            \ 25
"mean" apropos                                    \ the mean-family words
' 2dup see                                        \ : 2dup over over ;
help map                                          \ map's reference frame

\ bare help (no name left on the line) prints the cheat sheet
help

clear

\ ==== apropos ====

\ apropos matches word names and reference summaries, case-insensitively
"frobenius" apropos

\ session-defined words match by name
: zork-test 1 ;
"ZORK" apropos

\ no match prints nothing
"qqqqxyzzy" apropos

clear

\ ==== telic version ====

\ telic-version ( -- str ): the interpreter version, the string `telic` prints.

telic-version string? . cr                           \ 1
telic-version "^\d+\.\d+\.\d+$" has? . cr            \ 1
telic-version telic-version = . cr                   \ 1

clear
