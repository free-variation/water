\ FFI through libffi (libcurl): fixed-arity calls and a variadic call.
\ Library paths try the Darwin name first, then the Linux soname.

( darwin linux -- handle ) \ open whichever library name this OS resolves
: ffi-open-either | darwin linux |
	darwin ' ffi-open curry catch if drop linux ffi-open then ;

"hello from ffi variadic" "/tmp/lf_ffi_test.txt" write-file
"/usr/lib/libcurl.4.dylib" "libcurl.so.4" ffi-open-either to curl

\ fixed: curl_easy_strerror ( int -- string )
curl "curl_easy_strerror" [ :int ] :string ffi-function curl-strerror
0 curl-strerror . cr
6 curl-strerror . cr
28 curl-strerror . cr

\ variadic: curl_easy_setopt(handle, CURLOPT_URL, str) via ffi_prep_cif_var,
\ then perform a file:// fetch — the body proves the variadic string arg landed.
curl "curl_easy_init"    [ ]                    :ptr  ffi-function curl-init
curl "curl_easy_setopt"  [ :ptr :int :string ]  :int  2 ffi-variadic curl-setopt-str
curl "curl_easy_perform" [ :ptr ]               :int  ffi-function curl-perform
curl "curl_easy_cleanup" [ :ptr ]               :void ffi-function curl-cleanup
curl-init to h
h 10002 "file:///tmp/lf_ffi_test.txt" curl-setopt-str drop
h curl-perform to code
cr code . cr
h curl-cleanup

\ matrix>pointer: hand a C function a writable double buffer and read the result back.
\ modf(x, *iptr) returns the fractional part and writes the integer part to *iptr.
"/usr/lib/libSystem.B.dylib" "libm.so.6" ffi-open-either to libm
libm "modf" [ :double :ptr ] :double ffi-function modf
1 1 0-matrix to part
3.75 part matrix>pointer modf . cr    \ 0.75  (fractional part, returned)
part 0 @e . cr                        \ 3     (integer part, written into the matrix)

\ segment>pointer: the int * out-parameter.
\ frexp(x, *exp) returns the mantissa in [0.5, 1) and writes the exponent to *exp.
libm "frexp" [ :double :ptr ] :double ffi-function frexp
1 int-segment to exponent-cell
8.0 exponent-cell segment>pointer frexp . cr   \ 0.5   (mantissa, returned)
exponent-cell 0 @i . cr                        \ 4     (exponent, written into the segment)

clear
\ === pointer lifetime ===
\ matrix>pointer aliases the live element buffer; a GC while the handle is held
\ must keep the matrix reachable, not free the buffer the handle points into.
3 3 0-matrix matrix>pointer gc pointer-long . cr   \ 0

clear
\ === error cases ===
pointer-cell dup ffi-free pointer-deref            \ (read through a freed pointer)
clear
pointer-cell dup ffi-free pointer-long             \ (read through a freed pointer)
clear
pointer-cell dup ffi-free 1 floats>matrix          \ (read through a freed pointer)
clear
pointer-cell dup ffi-free 0 pointer-string-at      \ (read through a freed pointer)
